@startuml ClassDiagram

abstract class "A. USER" as USER {
  - userId : String
  - name : String
  - email : String
  --
  + login()
  + receiveNotification(n: Notification)
}

class "C. Faculty" as Faculty {
  - facultyId : String
  - department : String
  --
  + viewTimetable()
  + requestClassroom()
}

class "C. Student" as Student {
  - studentId : String
  - program : String
  --
  + viewTimetable()
}

class "C. Administrator" as Administrator {
  - adminId : String
  --
  + manageIssue(Issue: Issue)
  + approveBooking(request: BookingRequest)
}

class "C. ClassRepresentative" as ClassRepresentative {
  --
  + requestRoomChange(session: ClassSession)
  + requestBooking(request: bookingRequest)
}

class "C. Notification" as Notification {
  - notificationId : String
  - message : String
  - timestamp : DateTime
  - type : String
  --
  + send()
}

class "C. TimeTable" as TimeTable {
  - timetableId : String
  - semester : String
  --
  + getSchedule()
}

class "C. ClassSession" as ClassSession {
  - subject : String
  - day : String
  - startTime : Time
  - endTime : Time
  - status : String
  --
  + cancel()
  + reschedule(room : Classroom)
}

class "C. Issue" as Issue {
  - issueId : String
  - description : String
  - status : String
  - reportedTime : DateTime
  --
  + resolve()
}

class "C. BookingRequest" as BookingRequest {
  - requestid : String
  - requestedDate : Date
  - purpose : String
  - status : String
  --
  + approve()
  + reject()
}

class "C. Subject" as Subject {
  - subjectid : String
  - subjectName : String
  - credits : int
}

class "C. Classroom" as Classroom {
  - roomNumber : String
  - capacity : int
  - status : String
  --
  + chechAvailability() : Boolean
}

' Inheritance
USER <|-- Faculty
USER <|-- Student
USER <|-- Administrator
Student <|-- ClassRepresentative

' Associations
USER "1" --> "*" Notification : receives

Faculty "1" --> "*" ClassSession : teaches

Student "1" --> "*" TimeTable : views

TimeTable "1" o--> "*" ClassSession : contains

ClassRepresentative "1" --> "*" BookingRequest : creates

Administrator "1" --> "*" BookingRequest : approves

Administrator "1" --> "*" Issue : manages

ClassSession "*" --> "1" Subject : covers

ClassSession "*" --> "1" Classroom : held in

@enduml
